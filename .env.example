# Copiez ce fichier en .env et renseignez les valeurs (ne le publiez JAMAIS sur GitHub).
PORT=8096
SITE_URL=https://votre-domaine.com
DATABASE_URL=postgres://defis:MOT_DE_PASSE@localhost:5432/defis
# Protège les numéros de pièce d'identité. À sauvegarder : si elle est perdue, ils sont illisibles.
DATA_KEY=changez-moi-phrase-secrete-longue
ADMIN_TOKEN=changez-moi-jeton-admin
MIN_AGE=18
# CashPay All : paiements (carte + Mobile Money) et SMS
CASHPAY_BASE=https://api.cashpay-all.com
CASHPAY_API_KEY=
CASHPAY_API_SECRET=
SMS_SENDER_ID=21Defis
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Les 21 Défis <no-reply@votre-domaine.com>"
# Envoi progressif : messages par cycle de 15 s
SMS_BATCH=20
EMAIL_BATCH=10
